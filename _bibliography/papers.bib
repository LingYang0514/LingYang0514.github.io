    dimensions={false},
    google_scholar_id={6h09tasAAAAJ:u5HHmVD_uO8C},
    additional_info={IF: 33.6},
    annotation={# Equal contribution, * Corresponding author},
    selected={true},
}

@article{Han2022Droplet,
    abbr={Small},
    title={Droplet bouncing: Fundamentals, regulations, and applications},
    author={Han, X. and Li, J. Q. and Tang, X. and Li, W. and Zhao, H. B. and Yang, L. and Wang, L. Q.},
    journal={Small},
    publisher={Wiley - VCH Verlag GmbH & Co. KGaA},
    year={2022},
    volume={18},
    issue={22},
    pages={2200277},
    doi={10.1002/smll.202200277},
    html={https://onlinelibrary.wiley.com/doi/abs/10.1002/smll.202200277},
    url={https://doi.org/10.1002/smll.202200277},
    abstract={Droplet impact is a ubiquitous phenomenon in nature, daily life, and industrial processes. It is thus crucial to tune the impact outcomes for various applications. As a special outcome of droplet impact, the bouncing of droplets keeps the form of the droplets after the impact and minimizes the energy loss during the impact, being beneficial in many applications. A unified understanding of droplet bouncing is in high demand for effective development of new techniques to serve applications. This review shows the fundamentals, regulations, and applications of millimeter‐sized droplet bouncing on solid surfaces and same/miscible liquids (liquid pool and another droplet). Regulation methods and current applications are summarized, and potential directions are proposed.},
    altmetric={},
    dimensions={false},
    google_scholar_id={6h09tasAAAAJ:u-x6o8ySG0sC},
    additional_info={IF: 13.0},
    annotation={# Equal contribution, * Corresponding author},
    selected={true},
}
